/*=======================================================================================*/
/*  powerpc-sail: A Sail model of the PowerPC ISA (PowerPC 601 first)                    */
/*  SPDX-License-Identifier: MIT (see LICENSE)                                           */
/*=======================================================================================*/

/* ppc_mem.sail — physical memory access.
 *
 * The Sail C runtime provides a sparse little-endian byte memory via the
 * read_ram/write_ram primitives.  PowerPC storage is big-endian (the 601's
 * little-endian mode is a per-access address-munge, HID0[LM], MPC601UM
 * §2.4.3 — see le_munge below), so the accessors here byte-reverse.
 *
 * TODO: this is a bare "flat RAM" model:
 *   - no cache model (601: 32 KB unified, 8-way; MPC601UM ch. 4).  Likely
 *     stays unmodelled except for dcbz/architecturally-visible effects.
 *   - no memory-mapped devices; add a physical-memory map dispatcher here
 *     when devices (interrupt controller, UART for test I/O) are added.
 *   - eciwx/ecowx external control accesses unmodelled.
 */

$ifndef _PPC_MEM
$define _PPC_MEM

/* --- Little-endian address munging (MPC601UM §2.4.3.1) ------------------ */

/* The 601 does NOT byte-swap in little-endian mode; it manipulates the low
 * three address bits so that an aligned access of a given size lands where a
 * little-endian program expects:
 *
 *   New_addr[29] <- EA[29] xor (word | half | byte)
 *   New_addr[30] <- EA[30] xor (half | byte)
 *   New_addr[31] <- EA[31] xor (byte)
 *
 * which for the four operand sizes is exactly "xor (8 - width)": 7 for a
 * byte, 6 for a halfword, 4 for a word, and 0 for a double word, the last
 * being the manual's "addresses for aligned double-word accesses ... are not
 * modified".  Instruction fetch gets the same treatment at width 4, which is
 * how §2.4.3.3's "instructions are swapped within a double word" is
 * implemented.
 *
 * Two things stay UNMUNGED, both deliberately: the effective address a fault
 * reports (DAR and SRR0 hold the address before modification), and cache
 * control operations.  Physical addresses reached any other way — the page
 * table walk, a program loader — never come through here at all.
 *
 * Note the munge is applied to the PHYSICAL address, as the manual specifies.
 * It only ever changes the low three bits, so translation is unaffected and
 * it makes no difference whether it happens before or after; doing it last
 * keeps every reported address the architectural one. */
val le_munge : forall 'n, 'n in {1, 2, 4, 8}. (bits(32), int('n)) -> bits(32)
function le_munge(addr, width) =
  if core_bigendian() then addr
  else xor_vec(addr, to_word(8 - width))

/* --- Reservation for lwarx / stwcx. (§3.5.7) ---------------------------- */

/* The 601's reservation is a single flag.  The manual is explicit that the
 * conditional store succeeds on the flag alone — "the conditional store is
 * performed based upon the existence of a reservation established by the
 * preceding lwarx regardless of whether the address generated by the lwarx
 * matches that generated by the stwcx." — so the reserved address, though
 * architectural, is not observable from a single processor: it exists to let
 * another bus master cancel the reservation by writing inside the 32-byte
 * granule.  There is no other bus master here, so the address is not
 * modelled; add it (and the granule compare) together with whatever first
 * snoops.
 *
 * What DOES clear the reservation is the rest of §3.5.7's list: any stwcx.,
 * an sc, and any instruction that causes an exception or any asynchronous
 * exception — the last two are covered in one place, by take_exception.
 * Note an ordinary store by this processor is NOT on that list. */
register reservation_valid : bool

val set_reservation : unit -> unit
function set_reservation() = { harness_wrote(hw_reservation); reservation_valid = true }

val clear_reservation : unit -> unit
function clear_reservation() = { harness_wrote(hw_reservation); reservation_valid = false }

val reset_reservation : unit -> unit
function reset_reservation() = { reservation_valid = false }

val write_ram = impure "write_ram" : forall 'n 'm.
  (int('m), int('n), bits('m), bits('m), bits(8 * 'n)) -> unit

val read_ram = impure "read_ram" : forall 'n 'm.
  (int('m), int('n), bits('m), bits('m)) -> bits(8 * 'n)

/* These three functions are the only places physical memory is touched, which
 * is why the test-harness footprint hooks (ppc_harness.sail) sit here: one
 * call each, before the access, and nothing else in the model needs to know
 * they exist. */

/* Read 'n bytes at a physical address, returning them big-endian
 * (i.e. byte at lowest address = most significant). */
val phys_read : forall 'n, 'n in {1, 2, 4, 8}. (bits(32), int('n)) -> bits(8 * 'n)
function phys_read(paddr, width) = {
  harness_note_mem(harness_mem_read, paddr, get_slice_int(8, width, 0));
  reverse_endianness(read_ram(32, width, zeros(32), paddr))
}

val phys_write : forall 'n, 'n in {1, 2, 4, 8}. (bits(32), int('n), bits(8 * 'n)) -> unit
function phys_write(paddr, width, data) = {
  harness_note_mem(harness_mem_write, paddr, get_slice_int(8, width, 0));
  write_ram(32, width, zeros(32), paddr, reverse_endianness(data))
}

/* Instruction fetch from a physical address.  The instruction word itself is
 * always read big-endian; little-endian mode swaps the two words within a
 * double word before they reach the instruction queue (§2.4.3.3), which the
 * width-4 munge expresses — so in LE mode the instruction at address A comes
 * from the word stored at A xor 4, and LE code has to be laid out with each
 * aligned pair of instructions exchanged.
 *
 * Spelled out rather than delegating to phys_read so that the access is noted
 * once, as a fetch: a harness that wants to exclude instruction fetch from an
 * instruction's memory footprint must be able to tell the two apart. */
val phys_fetch : bits(32) -> bits(32)
function phys_fetch(paddr) = {
  let pa = le_munge(paddr, 4);
  harness_note_mem(harness_mem_fetch, pa, 0x04);
  reverse_endianness(read_ram(32, 4, zeros(32), pa))
}

/* Page-table-entry accesses, used only by the page table walk in
 * ppc_mmu.sail.  Identical to phys_read/phys_write at width 4 — a PTE is a
 * word, the walk never munges (le_munge applies to the ACCESS the program
 * asked for, not to the tables that describe it) — and spelled out separately
 * for one reason: so that the walk's traffic is noted under its own access
 * kind.  Without that a harness cannot tell the MMU's reads and its R/C-bit
 * writeback from the instruction's own loads and stores, and must attribute
 * both to the instruction (MPC601UM §6.8.4, §6.9.2). */
val phys_read_pte : bits(32) -> bits(32)
function phys_read_pte(paddr) = {
  harness_note_mem(harness_mem_walk_read, paddr, 0x04);
  reverse_endianness(read_ram(32, 4, zeros(32), paddr))
}

val phys_write_pte : (bits(32), bits(32)) -> unit
function phys_write_pte(paddr, data) = {
  harness_note_mem(harness_mem_walk_write, paddr, 0x04);
  write_ram(32, 4, zeros(32), paddr, reverse_endianness(data))
}

$endif
